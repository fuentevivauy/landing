{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuente-viva-assets-upload",
  "main": "src/index.mjs",
  "compatibility_date": "2026-06-11",
  "routes": [
    {
      "pattern": "assets-upload.fuenteviva.uy",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "fuente-viva-assets"
    }
  ]
}
